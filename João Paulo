import java.util.List;

public class ContatoController {
    
    public void cadastrarContato(String nome, String telefone, String email) {
        if (nome == null || nome.trim().isEmpty()) {
            System.out.println("Nome é obrigatório!");
            return;
        }
        if (telefone == null || telefone.trim().isEmpty()) {
            System.out.println("Telefone é obrigatório!");
            return;
        }
        if (email == null || email.trim().isEmpty()) {
            System.out.println("Email é obrigatório!");
            return;
        }
        
        Pessoa pessoa = new Pessoa(nome.trim(), telefone.trim(), email.trim());
        PessoaDAO.inserirPessoa(pessoa);
    }
    
    public List<Pessoa> listarContatos() {
        return PessoaDAO.listarPessoas();
    }
    
    public void atualizarContato(int id, String nome, String telefone, String email) {
        if (id <= 0) {
            System.out.println("ID inválido!");
            return;
        }
        if (nome == null || nome.trim().isEmpty()) {
            System.out.println("Nome é obrigatório!");
            return;
        }
        if (telefone == null || telefone.trim().isEmpty()) {
            System.out.println("Telefone é obrigatório!");
            return;
        }
        if (email == null || email.trim().isEmpty()) {
            System.out.println("Email é obrigatório!");
            return;
        }
        
        Pessoa pessoa = new Pessoa(nome.trim(), telefone.trim(), email.trim());
        PessoaDAO.atualizarPessoa(id, pessoa);
    }
    
    public void excluirContato(int id) {
        if (id <= 0) {
            System.out.println("ID inválido!");
            return;
        }
        PessoaDAO.deletarPessoa(id);
    }
}
